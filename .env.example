# Copy to .env and fill in. Never commit the real .env.

# IB Gateway / TWS connection. 7497 = paper TWS, 7496 = live TWS,
# 4002 = paper Gateway, 4001 = live Gateway.
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# Reconcile ACCOUNT_EQUITY_USD against actual IBKR account value before
# going live -- this is only a starting/paper default.
ACCOUNT_EQUITY_USD=5000

# Instant alerts (circuit breaker, etc). Get this from the Slack app's
# Incoming Webhooks page for the target channel.
SLACK_WEBHOOK_URL=

TRADE_LOG_PATH=logs/trades.csv
